{
  "manifest_version": 3,
  "name": "ScrollRot",
  "version": "1.0",
  "description": "Help people get off short form content.",
  "action": {
    "default_popup": "src/popupPage/index.html"
  },
  "icons": {
    "16": "assets/icon_16.png",
    "32": "assets/icon_32.png",
    "48": "assets/icon_48.png",
    "128": "assets/icon_128.png"
  },
  "options_page": "src/optionsPage/index.html",
  "permissions": ["tabs", "storage"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content-scripts/youtube.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content-scripts/instagram.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": ["content-scripts/tiktok.js"],
      "run_at": "document_start"
    }
  ]
}
