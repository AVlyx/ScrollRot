{
  "manifest_version": 3,
  "name": "Stripe and firebase React",
  "version": "1.0",
  "description": "Stripe and firebase",
  "action": {
    "default_popup": "src/popupPage/index.html",
    "default_icon": "assets/icon.png"
  },
  "options_page": "src/optionsPage/index.html",
  "permissions": ["tabs", "identity", "identity.email", "storage"],
  "host_permissions": [
    "https://*.chromiumapp.org/*",
    "https://*.firebaseapp.com/",
    "https://*.googleapis.com/"
  ],
  "oauth2": {
    "client_id": "579601400309-5hlpl7grbob9q6tqbka9j60l7h7b3iu8.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/userinfo.email"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },

  "web_accessible_resources": [
    {
      "resources": ["firebase/*.js", "firebase/*/*.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content-scripts/youtube.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content-scripts/instagram.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": ["content-scripts/tiktok.js"],
      "run_at": "document_start"
    }
  ]
}
