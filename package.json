{
  "name": "scrollrot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "dependencies": {
    "@preact/compat": "^18.3.1",
    "preact": "^10.27.2",
    "webextension-polyfill": "^0.12.0"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build:chrome": "node build.mjs chrome",
    "build:firefox": "node build.mjs firefox",
    "build": "npm run build:chrome && npm run build:firefox",
    "zip:chrome": "node zipDist.mjs chrome",
    "zip:firefox": "node zipDist.mjs firefox",
    "zip": "npm run zip:chrome && npm run zip:firefox",
    "screenpromo:marquee": "npx capture-website assets/marquee-promo.html --width=1400 --height=560 --output=assets/marquee-promo.png --overwrite --scale-factor=1",
    "screenpromo:small": "npx capture-website assets/small-promo.html --width=440 --height=280 --output=assets/small-promo.png --overwrite --scale-factor=1",
    "screenpromo:og": "npx capture-website assets/og-image.html --width=1200 --height=630 --output=website/assets/og-image.png --overwrite --scale-factor=1",
    "screenpromo:p1": "npx capture-website assets/p1.html --width=1280 --height=800 --output=assets/p1.png --overwrite --scale-factor=1",
    "screenpromo:p2": "npx capture-website assets/p2.html --width=1280 --height=800 --output=assets/p2.png --overwrite --scale-factor=1",
    "screenpromo:p3": "npx capture-website assets/p3.html --width=1280 --height=800 --output=assets/p3.png --overwrite --scale-factor=1",
    "screenpromo:pages": "npm run screenpromo:p1 && npm run screenpromo:p2 && npm run screenpromo:p3",
    "screenpromo": "npm run screenpromo:marquee && npm run screenpromo:small && npm run screenpromo:pages"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@preact/preset-vite": "^2.10.2",
    "@types/chrome": "^0.1.24",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/webextension-polyfill": "^0.12.1",
    "@vitejs/plugin-react": "^5.0.4",
    "archiver": "^7.0.1",
    "babel-plugin-react-compiler": "^19.1.0-rc.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "npm:rolldown-vite@7.1.14"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.1.14"
  }
}
